# Rapid Crisis Response — environment variables
# Copy to .env and fill in.

# Nebius Token Factory API key (https://tokenfactory.nebius.com → API keys)
# Leave empty to run with the offline rule-based fallback.
NEBIUS_API_KEY=

# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Fast model that dispatches the team (one tool-calling round, ~3 s)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Reasoning model that reviews each dispatch in the background (~10-20 s, never delays paging)
NEBIUS_REVIEW_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# 1 = let Ultra reason before answering (better reviews, a few seconds slower)
NEBIUS_REVIEW_THINKING=1

# Where the audit log is written (JSON lines)
AUDIT_LOG_PATH=crisis_audit.jsonl

# Public-demo guards (protect Token Factory credits)
# Dispatches allowed per device per minute, and Ultra reviews per hour across all users.
# Over the review budget, dispatch still works; only the second opinion is skipped.
DISPATCH_LIMIT_PER_MINUTE=5
REVIEW_LIMIT_PER_HOUR=60
# Set to lock POST /reset behind header X-Reset-Token (this also disables the dashboard's Reset button)
RESET_TOKEN=
