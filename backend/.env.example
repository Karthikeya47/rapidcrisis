# Rapid Crisis Response — environment variables
# Copy to .env and fill in.

# Nebius Token Factory API key (https://tokenfactory.nebius.com → API keys)
# Leave empty to run with the offline rule-based fallback.
NEBIUS_API_KEY=

# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Where the audit log is written (JSON lines)
AUDIT_LOG_PATH=crisis_audit.jsonl
